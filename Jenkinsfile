pipeline {
    agent any 
        stages {
            stage("Checkout") {
                steps {
                    echo "Checking out from the program"
                }
            }
            stage("Development") {
                echo "On to the development stage"
            }
            stage("Testing") {
                echo "On to the Testing stage"
            }
            stage("Deployment on to the production enviroenment") {
                echo "Production Deployment in production"
            }
        }
    }
